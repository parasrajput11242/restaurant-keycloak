{
  "realm": "restaurant-review",
  "enabled": true,
  "displayName": "Restaurant Reviews",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "defaultRole": {
    "name": "default-roles-restaurant-review"
  },
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "USER",
        "description": "Can browse, and write reviews. Granted to every new account."
      },
      {
        "name": "RESTAURANT_OWNER",
        "description": "Can create and manage their own restaurants. Includes USER.",
        "composite": true,
        "composites": {
          "realm": [
            "USER"
          ]
        }
      },
      {
        "name": "ADMIN",
        "description": "Approves owner requests, moderates reviews, manages all restaurants.",
        "composite": true,
        "composites": {
          "realm": [
            "RESTAURANT_OWNER",
            "USER"
          ]
        }
      },
      {
        "name": "default-roles-restaurant-review",
        "description": "Roles every new user gets automatically",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "USER"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "restaurant-review-app",
      "name": "Restaurant Review Web App",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${FRONTEND_URL:http://localhost:3000}",
      "baseUrl": "/",
      "redirectUris": [
        "${FRONTEND_URL:http://localhost:3000}/*"
      ],
      "webOrigins": [
        "${FRONTEND_URL:http://localhost:3000}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONTEND_URL:http://localhost:3000}/*"
      }
    },
    {
      "clientId": "restaurant-review-backend",
      "name": "Restaurant Review Backend (service account)",
      "description": "Lets the API grant the RESTAURANT_OWNER role when an admin approves a request.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET:change-me-dev-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-restaurant-review-backend",
      "enabled": true,
      "serviceAccountClientId": "restaurant-review-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "admin",
      "email": "admin@restaurant.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Site",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${INITIAL_ADMIN_PASSWORD:admin}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    }
  ]
}